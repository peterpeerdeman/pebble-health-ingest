{
  "uid": "pebble-health",
  "title": "Pebble Health",
  "tags": ["pebble", "health"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5m",
  "time": { "from": "now-7d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": { "type": "influxdb", "uid": "influx-pebble" },
        "query": "SHOW TAG VALUES FROM \"pebble_minute\" WITH KEY = \"device\"",
        "refresh": 1,
        "includeAll": true,
        "multi": false,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Heart rate (raw minutes)",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "influx-pebble" },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "query": "SELECT mean(\"hr\") FROM \"pebble_minute\" WHERE \"device\" =~ /^$device$/ AND $timeFilter GROUP BY time(5m) fill(null)",
          "resultFormat": "time_series",
          "alias": "bpm"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 40,
          "custom": { "drawStyle": "points", "pointSize": 3, "spanNulls": false }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "hidden" }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Resting heart rate (daily minimum)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "influxdb", "uid": "influx-pebble" },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "query": "SELECT min(\"hr\") FROM \"pebble_minute\" WHERE \"device\" =~ /^$device$/ AND $timeFilter GROUP BY time(1d) fill(none)",
          "resultFormat": "time_series",
          "alias": "resting bpm"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "showPoints": "always", "spanNulls": true }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "hidden" }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "Steps per day",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "influxdb", "uid": "influx-pebble" },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "query": "SELECT last(\"steps\") FROM \"pebble_daily\" WHERE \"device\" =~ /^$device$/ AND $timeFilter GROUP BY time(1d) fill(0)",
          "resultFormat": "time_series",
          "alias": "steps"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "hidden" }, "xTickLabelRotation": -45 }
    },
    {
      "id": 4,
      "type": "barchart",
      "title": "Sleep (hours): total vs restful",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "influxdb", "uid": "influx-pebble" },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "query": "SELECT last(\"sleep_s\")/3600 AS \"total\", last(\"sleep_restful_s\")/3600 AS \"restful\" FROM \"pebble_daily\" WHERE \"device\" =~ /^$device$/ AND $timeFilter GROUP BY time(1d) fill(0)",
          "resultFormat": "time_series",
          "alias": "$col"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "h", "decimals": 1 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "xTickLabelRotation": -45 }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Steps per 15 min",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "influxdb", "uid": "influx-pebble" },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "query": "SELECT sum(\"steps\") FROM \"pebble_minute\" WHERE \"device\" =~ /^$device$/ AND $timeFilter GROUP BY time(15m) fill(0)",
          "resultFormat": "time_series",
          "alias": "steps"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "hidden" }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Minutes received in last 30h (alert if 0)",
      "description": "Sized to the 12-hour wakeup cadence with slack for one missed link, and well inside the 7-day retention window on the watch.",
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 25 },
      "datasource": { "type": "influxdb", "uid": "influx-pebble" },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "query": "SELECT count(\"vmc\") FROM \"pebble_minute\" WHERE \"device\" =~ /^$device$/ AND time > now() - 30h",
          "resultFormat": "time_series",
          "alias": "minutes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Recent activities",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 25 },
      "datasource": { "type": "influxdb", "uid": "influx-pebble" },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "query": "SELECT \"type\", \"duration_s\"/60 AS \"minutes\" FROM \"pebble_activity\" WHERE \"device\" =~ /^$device$/ AND $timeFilter ORDER BY time DESC LIMIT 20",
          "resultFormat": "table"
        }
      ],
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "options": {}
    }
  ]
}
